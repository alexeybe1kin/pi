    "/turns/unreplied": {
      "get": {
        "summary": "Unreplied",
        "description": "Turns that acted but never reported back.\n\nResumable, and resuming asks only for the missing reply - the action is\nnever repeated. Separate from /approvals on purpose: these need a retry,\nnot a decision.",
        "operationId": "unreplied_turns_unreplied_get",
