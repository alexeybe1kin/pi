    "/turns/{turn_id}/resume": {
      "post": {
        "summary": "Resume",
        "description": "Continue a parked turn after the owner approved it in ToolGate.\n\nPi does not grant approvals and does not hold them. This replays the exact\nstored action; ToolGate consumes the nonce, once, and refuses a replay.",
        "operationId": "resume_turns__turn_id__resume_post",
        "parameters": [
          {
            "name": "turn_id",
            "in": "path",
            "required": true,
