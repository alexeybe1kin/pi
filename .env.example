# Copy to .env next to docker-compose.yml. .env is gitignored; never commit it.
# Precedence is environment -> file -> default.

# Required. Pi refuses to start without it. At least 16 characters.
#   echo "PI_ADMIN_KEY=$(openssl rand -base64 24)" >> .env
PI_ADMIN_KEY=

# Optional. Where sessions and execution history live. Back this up: it is the
# transcript, and MemoryGate's evidence cites message ids from it.
# PI_DB_PATH=/data/pi.db

# Optional. The model Pi talks to, and where.
# PI_OLLAMA_URL=http://ollama:11434
# PI_MODEL=qwen3:4b

# Optional. Prepended to every conversation.
# PI_SYSTEM_PROMPT=You are Conker.

# Optional. Hosted models through OpenRouter, used only when a turn
# escalates. Without it Pi answers locally and says so.
# PI_OPENROUTER_KEY=

# Optional. Off means free models only, enforced in code rather than
# left to configuration. Set to 1 to spend deliberately.
# PI_ALLOW_PAID_MODELS=
